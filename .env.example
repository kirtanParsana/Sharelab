PORT=3000
HOST=0.0.0.0

# Hosted Turso (required in production / on Render)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Local development: omit the two variables above, or point at a file database:
# TURSO_DATABASE_URL=file:./data/sharelab.db
# TURSO_AUTH_TOKEN=

DEMO_PASSWORD=choose-a-password      # password for all demo accounts, applied when the DB is first seeded
SEED_DEMO=1                          # set 0 to start with an empty database (no demo users). Seeding never wipes existing users.
TRUST_PROXY=1                        # 1 behind Render/Railway/Fly (reads X-Forwarded-For), 0 otherwise
RESEND_API_KEY=                      # optional: real email delivery
MAIL_FROM=ShareLab <onboarding@resend.dev>
ANTHROPIC_API_KEY=                   # optional: AI matching, incident summaries, certificate assist
AI_MODEL=claude-sonnet-5-5
